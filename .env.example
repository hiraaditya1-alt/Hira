# Disarankan: kunci Vercel AI Gateway (satu kunci untuk banyak model).
# Buat di Vercel Dashboard → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=

# Opsional. Model melalui gateway memakai prefix penyedia, contoh:
# anthropic/claude-sonnet-4-6  atau  openai/gpt-4.1-mini
AI_MODEL=anthropic/claude-sonnet-4-6

# Alternatif: panggil Anthropic langsung (tanpa AI Gateway).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Opsional: origin tambahan yang boleh memanggil API, dipisahkan koma.
# Origin deployment Vercel saat ini diterima otomatis.
ALLOWED_ORIGINS=https://legacyos.example.com
